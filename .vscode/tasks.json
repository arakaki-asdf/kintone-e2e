{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "shell",
      "label": "Playwright: Run Tests",
      "command": "source ~/.zshrc && npx playwright test",
      "options": {
        "shell": {
          "executable": "/bin/zsh",
          "args": ["-l", "-c"]
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "type": "shell",
      "label": "Playwright: UI Mode (Interactive)",
      "command": "source ~/.zshrc && npx playwright test --ui",
      "options": {
        "shell": {
          "executable": "/bin/zsh",
          "args": [ "-l", "-c" ]
        },
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
      },
      "problemMatcher": []
    }
  ]
}